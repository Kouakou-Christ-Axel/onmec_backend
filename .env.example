NODE_ENV=
PORT=
BASE_URL=""
FRONTEND_URL=""
CDN_URL=""
BACKEND_URL=""

# DATABASE
DATABASE_URL=""
# Base jetable utilisee par `prisma migrate dev` et `migrate diff --from-migrations`.
SHADOW_DATABASE_URL=""
# Mot de passe initial des comptes back-office crees par le seed.
# Obligatoire en production (le seed echoue sinon).
SEED_ADMIN_PASSWORD=""

# AUTHENTICATION
#
# Toutes ces variables ont un defaut hors production (voir
# src/config/env.validation.ts) : une instance locale demarre avec un .env vide.
#
# En PRODUCTION (NODE_ENV=production), TOKEN_SECRET et REFRESH_TOKEN_SECRET
# restent obligatoires et l'application refuse de demarrer sans eux : hors
# production, ce sont des secrets de developpement ecrits en clair dans le
# depot, donc connus de quiconque lit le code.
#
# Les deux secrets doivent etre DIFFERENTS l'un de l'autre — avec un secret
# unique, un refresh token se verifie comme un token d'acces. Au moins 32
# caracteres recommandes (en deca : avertissement au demarrage, pas d'echec).
# Pour en generer un :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
TOKEN_SECRET=""
REFRESH_TOKEN_SECRET=""

# Durees de validite. Defauts : 15m et 7d. Une valeur explicite mal formee fait
# echouer le demarrage — une expiration vide produisait des JWT eternels.
TOKEN_EXPIRATION="15m"
REFRESH_TOKEN_EXPIRATION="7d"

# Cout du hachage bcrypt. Defaut 12.
BCRYPT_ROUNDS="12"

# Autorise le seed a inserer les donnees de demonstration meme en production.
# A laisser vide : ces donnees contiennent des comptes dont le mot de passe est
# litteralement "password".
ALLOW_PROD_SEED=""

# CLOUDFLARE R2 (stockage fichiers)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""   # domaine personnalise connecte au bucket, ex: https://cdn.mec-ci.org

# FIREBASE (notifications push)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# TWILIO (SMS OTP)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# RESEND (emails transactionnels + vérification OTP)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@onmec.ci"

# SMTP (emails transactionnels fallback)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# KKIAPAY (paiement mobile money)
KKIAPAY_PUBLIC_KEY=""
KKIAPAY_PRIVATE_KEY=""
KKIAPAY_SECRET_KEY=""

# REDIS (BullMQ — jobs asynchrones)
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""
