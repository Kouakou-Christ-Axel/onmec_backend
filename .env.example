NODE_ENV=
PORT=
BASE_URL=""
FRONTEND_URL=""
CDN_URL=""
BACKEND_URL=""

# DATABASE
DATABASE_URL=""
# Base jetable utilisee par `prisma migrate dev` et `migrate diff --from-migrations`.
SHADOW_DATABASE_URL=""
# Mot de passe initial des comptes back-office crees par le seed.
# Obligatoire en production (le seed echoue sinon).
SEED_ADMIN_PASSWORD=""

# AUTHENTICATION
#
# Ces quatre variables sont OBLIGATOIRES : l'application refuse de demarrer si
# l'une manque (voir src/config/env.validation.ts). C'est deliberé — une
# TOKEN_EXPIRATION absente produisait auparavant des JWT sans date
# d'expiration, donc valables indefiniment.
#
# Les secrets doivent faire au moins 32 caracteres. Pour en generer un :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
TOKEN_SECRET=""
TOKEN_EXPIRATION="15m"
REFRESH_TOKEN_SECRET=""
REFRESH_TOKEN_EXPIRATION="7d"

# Cout du hachage bcrypt. Optionnel, defaut 12.
BCRYPT_ROUNDS="12"

# Autorise le seed a inserer les donnees de demonstration meme en production.
# A laisser vide : ces donnees contiennent des comptes dont le mot de passe est
# litteralement "password".
ALLOW_PROD_SEED=""

# AWS S3
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET_NAME=""

# FIREBASE (notifications push)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# TWILIO (SMS OTP)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# RESEND (emails transactionnels + vérification OTP)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@onmec.ci"

# SMTP (emails transactionnels fallback)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# KKIAPAY (paiement mobile money)
KKIAPAY_PUBLIC_KEY=""
KKIAPAY_PRIVATE_KEY=""
KKIAPAY_SECRET_KEY=""

# REDIS (BullMQ — jobs asynchrones)
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""
